/* Celestrium cockpit styling.
 *
 * Colours come from Textual theme *variables* ($surface, $panel, $primary, …),
 * NOT hard-coded hex — so Ctrl+T actually recolours the whole cockpit and the
 * default ansi-dark theme looks right in any terminal palette. Layout + structure
 * live here; the palette is whatever theme is active.
 */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 30;
    background: $panel;
    border-right: vkey $primary 40%;
    padding: 1 1;
}

#main {
    width: 2fr;
    padding: 0 1;
}

#preview {
    width: 1fr;
    background: $panel;
    border-left: vkey $primary 40%;
    padding: 1 1;
}

#detail-scroll {
    height: 1fr;
    background: $surface;
    border: round $primary 30%;
    padding: 0 1;
}

.heading {
    color: $accent;
    text-style: bold;
    margin: 1 0 0 0;
}

.dim {
    color: $text-muted;
}

#controls {
    height: auto;
    padding: 1 0;
}

#archive {
    width: 18;
    margin: 0 1 0 0;
}

#entry {
    width: 1fr;
    border: tall $primary 50%;
}

#entry:focus {
    border: tall $accent;
}

#results {
    height: 1fr;
    border: round $primary 30%;
}

#detail {
    color: $foreground;
    height: auto;
}

/* The ELITE-style rotating-wireframe panel. */
#orrery {
    height: 14;
    border: round $accent 40%;
    color: $primary;
    background: $surface;
    content-align: center middle;
}

#status {
    height: 7;
    background: $surface;
    border-top: hkey $primary 40%;
    color: $text-muted;
    padding: 0 1;
}

ListView {
    background: transparent;
    border: none;
}

ListItem {
    padding: 0 1;
}

ListItem.--highlight {
    background: $primary 30%;
}

/* Modal dialogs (save list / image settings / about). */
ModalScreen {
    align: center middle;
}

#modal-box {
    width: 64;
    height: auto;
    background: $panel;
    border: round $accent;
    padding: 1 2;
}

.modal-actions {
    height: auto;
    margin: 1 0 0 0;
}

.modal-actions Button {
    margin: 0 1 0 0;
}

#about-body {
    height: auto;
    padding: 0 0 1 0;
}
