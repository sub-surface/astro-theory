/* Celestrium cockpit styling.
 * Collapsed minimal, prompt-centric design.
 */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

#body {
    height: 1fr;
}

#canvas-container {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#controls {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#prompt-prefix {
    text-style: bold;
    color: $accent;
    padding: 0 1 0 0;
}

#sys-status {
    padding: 0 0 0 1;
}

#entry {
    width: 1fr;
    border: none;
    background: $surface;
    padding: 0 1;
}

#entry:focus {
    background: $panel;
}

#canvas {
    height: 1fr;
    border: none;
    background: transparent;
}

#canvas.idle {
    border: none;
}

#results {
    height: 1fr;
    border: none;
}

/* Detail scroll when showing cards */
#detail-scroll {
    height: 1fr;
    padding: 1 2;
    overflow-y: scroll;
}

#target-hud {
    height: 1;
    width: 1fr;
    content-align: center top;
    margin-bottom: 1;
}

/* Ambient strip on the right */
#ambient-strip {
    width: 26;
    background: transparent;
    border: none;
    padding: 1 1;
}

#orrery-mini {
    height: 9;
    border: none;
    color: $primary;
    background: transparent;
    content-align: center middle;
    margin-bottom: 1;
}

#trail-list {
    height: 1fr;
    background: transparent;
    border: none;
}

#trail-list ListItem {
    padding: 0;
}

#trail-list ListItem.--highlight {
    background: $primary 30%;
}

.trail-item {
    padding: 0 1;
    color: $text-muted;
}

.trail-item.active {
    color: $accent;
    text-style: bold;
}

#status {
    height: 8;
    background: transparent;
    border: none;
    color: $text-muted;
    padding: 0 1;
}

.heading {
    color: $accent;
    text-style: bold;
    margin: 1 0 0 0;
}

.dim {
    color: $text-muted;
}

/* Modal dialogs */
ModalScreen {
    align: center middle;
}

#modal-box {
    width: 80;
    height: auto;
    background: $panel;
    border: round $accent;
    padding: 1 2;
}

.modal-actions {
    height: auto;
    margin: 1 0 0 0;
}

.modal-actions Button {
    margin: 0 1 0 0;
}

#about-body {
    height: auto;
    padding: 0 0 1 0;
}
