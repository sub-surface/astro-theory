/* Celestrium cockpit styling.
 *
 * Layout contract (matches app.compose):
 *   #context-bar   one always-on line: view · target · table · archive · ADS
 *   #body          canvas (results / idle orrery) | side (detail · trail · orrery)
 *   #status        slim event log (Ctrl+D expands with debug)
 *   #controls      the prompt, REPL-style at the bottom
 *   Footer         key hints
 * Colours ride the active Textual theme via variables — no hard-coded hex.
 */

Screen {
    background: $background;
    color: $foreground;
}

#context-bar {
    height: 1;
    padding: 0 1;
    background: $panel;
}

#body {
    height: 1fr;
}

#canvas {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#orrery-idle {
    height: 1fr;
    color: $primary;
    background: transparent;
    content-align: center middle;
}

#results {
    height: 1fr;
    border: none;
}

/* Side panel: detail on top, trail + orrery beneath */
#side {
    width: 44;
    padding: 0 1;
    border-left: solid $panel;
}

#detail-scroll {
    height: 1fr;
    padding: 0 1;
}

#trail-list {
    height: 7;
    background: transparent;
    border: none;
}

#trail-list ListItem {
    padding: 0;
}

#trail-list ListItem.--highlight {
    background: $primary 30%;
}

.trail-item {
    padding: 0 1;
    color: $text-muted;
}

.trail-item.active {
    color: $accent;
    text-style: bold;
}

#orrery {
    height: 9;
    border: none;
    color: $primary;
    background: transparent;
    content-align: center middle;
    margin-bottom: 1;
}

#status {
    height: 3;
    background: transparent;
    border: none;
    color: $text-muted;
    padding: 0 1;
}

/* The prompt — REPL-style, above the footer */
#controls {
    height: auto;
    padding: 0 1;
    align: left middle;
}

#prompt-prefix {
    text-style: bold;
    color: $accent;
    padding: 0 1 0 0;
}

#entry {
    width: 1fr;
    border: none;
    background: $surface;
    padding: 0 1;
}

#entry:focus {
    background: $panel;
}

.heading {
    color: $accent;
    text-style: bold;
    margin: 1 0 0 0;
}

.dim {
    color: $text-muted;
}

/* Modal dialogs */
ModalScreen {
    align: center middle;
}

#modal-box {
    width: 80;
    height: auto;
    background: $panel;
    border: round $accent;
    padding: 1 2;
}

.modal-actions {
    height: auto;
    margin: 1 0 0 0;
}

.modal-actions Button {
    margin: 0 1 0 0;
}

#about-body {
    height: auto;
    padding: 0 0 1 0;
}
