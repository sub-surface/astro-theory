---
// The sky we work on, in Galactic coordinates (Hammer-Aitoff, l = 0 at the centre, increasing to the left).
// Positions come from site/src/data/sky.json (scripts/infra/export_sky.py, astropy ICRS -> Galactic).
// Drawn as SVG at build time; a small script adds the hover readout, click-through and layer toggles.
import SKY from '../data/sky.json';

const W = 720, PAD = 8;
const R = (W / 2 - PAD) / (2 * Math.SQRT2);
const H = Math.round(2 * R * Math.SQRT2 + 2 * PAD);
const cx = W / 2, cy = H / 2;
const proj = (l: number, b: number): [number, number] => {
  const L = ((((l + 180) % 360) + 360) % 360) - 180;
  const lam = (-L * Math.PI) / 180, phi = (b * Math.PI) / 180;
  const z = Math.sqrt(1 + Math.cos(phi) * Math.cos(lam / 2));
  return [cx + (R * 2 * Math.SQRT2 * Math.cos(phi) * Math.sin(lam / 2)) / z, cy - (R * Math.SQRT2 * Math.sin(phi)) / z];
};
const r1 = (v: number) => Math.round(v * 10) / 10;
const line = (pts: [number, number][]) => 'M' + pts.map(([x, y]) => `${r1(x)},${r1(y)}`).join('L');
const range = (a: number, b: number, s: number) => Array.from({ length: Math.round((b - a) / s) + 1 }, (_, i) => a + i * s);

const outline = line([...range(-90, 90, 3).map((b) => proj(179.999, b)), ...range(90, -90, -3).map((b) => proj(180.001, b))]) + 'Z';
const parallels = [-60, -30, 30, 60].map((b) => line(range(-179.9, 179.9, 3).map((L) => proj(L, b))));
const meridians = [-120, -60, 0, 60, 120].map((L) => line(range(-90, 90, 3).map((b) => proj(L, b))));
const plane = line(range(-179.9, 179.9, 3).map((L) => proj(L, 0)));
const band = line([...range(-179.9, 179.9, 3).map((L) => proj(L, 10)), ...range(179.9, -179.9, -3).map((L) => proj(L, -10))]) + 'Z';

type S = [number, number, string, string, string];
const search = (SKY.search as S[]).map(([l, b, name, cls, yr]) => {
  const [x, y] = proj(l, b);
  return { x: r1(x), y: r1(y), cls: cls === 'symbiotic' ? 'sym' : cls === 'nova' ? 'nov' : 'rn', l, b,
           label: `${name} · ${cls === 'rn' ? 'recurrent nova' : cls}${yr ? ' ' + yr : ''}` };
});
const objects = SKY.objects.map((o) => { const [x, y] = proj(o.l, o.b); return { ...o, x: r1(x), y: r1(y) }; });
const dirs = SKY.directions.map((d) => { const [x, y] = proj(d.l, d.b); return { ...d, x: r1(x), y: r1(y) }; });
const star = (x: number, y: number, s = 6) =>
  `M${x},${y - s}L${x + s * 0.28},${y - s * 0.28}L${x + s},${y}L${x + s * 0.28},${y + s * 0.28}L${x},${y + s}L${x - s * 0.28},${y + s * 0.28}L${x - s},${y}L${x - s * 0.28},${y - s * 0.28}Z`;
// label placement [dx, dy, anchor]: the four objects near the Galactic centre would otherwise overlap
const place: Record<string, [number, number, string]> = {
  'T CrB': [10, 5, 'start'], 'RS Oph': [-10, -5, 'end'], 'V3890 Sgr': [-10, 16, 'end'], 'V745 Sco': [12, 22, 'start'],
  'V347 Nor': [-4, -11, 'middle'], 'DE Cir': [10, 17, 'start'], 'CMB dipole': [0, -11, 'middle'], 'CatWISE quasar dipole': [0, 22, 'middle'],
};
const at = (n: string) => place[n] || [10, 5, 'start'];
const fmt = (v: number) => (v >= 0 ? '+' : '−') + Math.abs(v).toFixed(2) + '°';
const hits = [
  ...objects.map((o) => [o.x, o.y, `${o.name} · ${o.note}`, `l ${o.l.toFixed(2)}° b ${fmt(o.b)}`, o.link, 1]),
  ...dirs.map((d) => [d.x, d.y, `${d.name} · ${d.note}`, `l ${d.l.toFixed(1)}° b ${fmt(d.b)}`, '', 1]),
  ...search.map((s) => [s.x, s.y, s.label, `l ${s.l.toFixed(2)}° b ${fmt(s.b)}`, '', 0]),
];
---

<div class="sky panel">
  <div class="bar">
    <span class="btns" role="group" aria-label="Layers">
      <button type="button" data-layer="search" aria-pressed="true">searched stars</button>
      <button type="button" data-layer="obj" aria-pressed="true">objects</button>
      <button type="button" data-layer="dir" aria-pressed="true">dipoles</button>
    </span>
    <span class="key small"><i class="k nov"></i>nova <i class="k sym"></i>symbiotic <i class="k rn"></i>recurrent nova</span>
  </div>
  <svg id="skymap" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Map of the sky in Galactic coordinates: the 1,211 novae and symbiotic stars searched on the Harvard plates, the objects with pages, and the CMB and quasar dipole directions">
    <path class="band" d={band} />
    <path class="grat" d={[...parallels, ...meridians].join('')} />
    <path class="plane" d={plane} />
    <path class="edge" d={outline} />
    <text class="lab" x={cx} y={cy + 62} text-anchor="middle">Galactic centre</text>
    <text class="lab" x={PAD + 4} y={cy - 4}>l = 180°</text>
    <text class="lab" x={cx} y={PAD + 12} text-anchor="middle">b = +90°</text>
    <g data-g="search">{search.map((s) => <circle class={s.cls} cx={s.x} cy={s.y} r={s.cls === 'rn' ? 2.2 : 1.3} />)}</g>
    <g data-g="dir">{dirs.map((d) => (
      <g class="dir"><circle cx={d.x} cy={d.y} r="6" /><path d={`M${d.x - 6},${d.y}h12M${d.x},${d.y - 6}v12`} />
        <text x={d.x + at(d.name)[0]} y={d.y + at(d.name)[1]} text-anchor={at(d.name)[2]}>{d.name}</text></g>
    ))}</g>
    <g data-g="obj">{objects.map((o) => (
      <a href={o.link} class="obj"><path d={star(o.x, o.y)} /><text x={o.x + at(o.name)[0]} y={o.y + at(o.name)[1]} text-anchor={at(o.name)[2]}>{o.name}</text></a>
    ))}</g>
    <circle id="sky-cursor" r="7" cx="-20" cy="-20" />
  </svg>
  <div id="sky-read" class="readout mono" aria-live="polite">{SKY.search_note}. Hover or tap the map.</div>
  <script type="application/json" id="sky-hits" set:html={JSON.stringify(hits)} />
</div>

<script is:inline>
  (function () {
    var svg = document.getElementById('skymap');
    var read = document.getElementById('sky-read');
    var cur = document.getElementById('sky-cursor');
    var hits = JSON.parse(document.getElementById('sky-hits').textContent);
    var shown = { search: true, obj: true, dir: true };
    var idle = read.textContent;
    // Readout transition: keep the shared prefix, then let the rest settle left to right,
    // each letter flicking through one or two glyphs first (a split-flap board, quietly).
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var GLYPHS = 'abcdefghijklmnopqrstuvwxyz0123456789·:+-°';
    var cur_txt = idle, from = idle, goal = idle, t0 = 0, raf = 0, p0 = 0, stag = 4;
    var say = function (t) {
      if (t === goal) return;
      if (still) { goal = cur_txt = t; read.textContent = t; return; }
      from = cur_txt; goal = t; t0 = performance.now();
      p0 = 0; while (p0 < from.length && p0 < t.length && from[p0] === t[p0]) p0++;
      stag = Math.min(5, 220 / Math.max(1, Math.max(from.length, t.length) - p0));
      if (!raf) raf = requestAnimationFrame(step);
    };
    var step = function (now) {
      var el = now - t0, n = Math.max(from.length, goal.length), out = goal.slice(0, p0), done = true;
      for (var i = p0; i < n; i++) {
        var at = (i - p0) * stag;
        if (el >= at + 45) { if (i < goal.length) out += goal[i]; continue; }
        done = false;
        if (el < at) out += i < from.length ? from[i] : '';
        else out += (i < goal.length && goal[i] === ' ') ? ' ' : GLYPHS[(Math.random() * GLYPHS.length) | 0];
      }
      cur_txt = done ? goal : out; read.textContent = cur_txt;
      read.setAttribute('aria-busy', done ? 'false' : 'true'); // screen readers hear only the settled text
      raf = done ? 0 : requestAnimationFrame(step);
    };
    var nearest = function (x, y) {
      var best = null, bd = 1e9;
      for (var i = 0; i < hits.length; i++) {
        var h = hits[i];
        if (h[5] ? !(h[4] ? shown.obj : shown.dir) : !shown.search) continue;
        var d = (h[0] - x) * (h[0] - x) + (h[1] - y) * (h[1] - y) - (h[5] ? 120 : 0);
        if (d < bd) { bd = d; best = h; }
      }
      return bd < 200 ? best : null;
    };
    var toSvg = function (ev) {
      var p = svg.createSVGPoint(); p.x = ev.clientX; p.y = ev.clientY;
      return p.matrixTransform(svg.getScreenCTM().inverse());
    };
    var at = null;
    var show = function (ev) {
      var p = toSvg(ev); at = nearest(p.x, p.y);
      if (at) {
        cur.setAttribute('cx', at[0]); cur.setAttribute('cy', at[1]);
        say(at[2] + '  (' + at[3] + ')' + (at[4] ? '  → click to open' : ''));
        svg.style.cursor = at[4] ? 'pointer' : 'crosshair';
      } else { cur.setAttribute('cx', -20); say(idle); svg.style.cursor = 'crosshair'; }
    };
    svg.addEventListener('pointermove', show);
    svg.addEventListener('pointerdown', show); // touch: a tap shows the readout
    svg.addEventListener('pointerleave', function (ev) { if (ev.pointerType !== 'mouse') return; cur.setAttribute('cx', -20); say(idle); });
    svg.addEventListener('click', function (ev) {
      if (ev.target.closest('a')) return;
      var p = toSvg(ev); var h = nearest(p.x, p.y);
      if (h && h[4] && ev.pointerType === 'mouse') location.href = h[4];
    });
    document.querySelectorAll('.sky [data-layer]').forEach(function (b) {
      b.addEventListener('click', function () {
        var k = b.dataset.layer; shown[k] = !shown[k];
        b.setAttribute('aria-pressed', shown[k] ? 'true' : 'false');
        svg.querySelector('[data-g="' + k + '"]').style.display = shown[k] ? '' : 'none';
      });
    });
  })();
</script>

<style>
  svg { display: block; width: 100%; height: auto; touch-action: manipulation; cursor: crosshair; }
  .band { fill: var(--band); }
  .grat { fill: none; stroke: var(--grid); stroke-width: 0.8; }
  .plane { fill: none; stroke: var(--faint); stroke-width: 1; stroke-dasharray: 3 3; }
  .edge { fill: none; stroke: var(--rule); stroke-width: 1; }
  .lab { fill: var(--muted); font: 12px "Courier New", Courier, monospace; }
  circle.nov { fill: var(--muted); opacity: 0.55; }
  circle.sym { fill: var(--old); opacity: 0.75; }
  circle.rn { fill: var(--alert); }
  .obj path { fill: #e6b800; stroke: var(--fg); stroke-width: 0.8; }
  .obj text, .dir text { fill: var(--fg); font: bold 13px "Courier New", Courier, monospace; paint-order: stroke; stroke: var(--box); stroke-width: 3px; }
  .obj:hover text, .obj:focus text { text-decoration: underline; }
  .dir circle { fill: none; stroke: var(--uv); stroke-width: 1.4; }
  .dir path { stroke: var(--uv); stroke-width: 1.4; }
  #sky-cursor { fill: none; stroke: var(--fg); stroke-width: 1; pointer-events: none; }
  .bar { display: flex; flex-wrap: wrap; gap: 0.4em 1em; align-items: center; margin-bottom: 0.4em; }
  .btns { display: inline-flex; flex-wrap: wrap; gap: 0.3em; }
  .btns button { font: inherit; font-size: 0.85em; padding: 2px 8px; color: var(--fg); background: var(--th); border: 2px outset var(--faint); cursor: pointer; }
  .btns button[aria-pressed="true"] { border-style: inset; background: var(--bg); font-weight: bold; }
  .k { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin: 0 0.25em 0 0.6em; }
  .k.nov { background: var(--muted); } .k.sym { background: var(--old); } .k.rn { background: var(--alert); }
  .readout { font-size: 0.82em; color: var(--muted); min-height: 2.6em; margin-top: 0.3em; }
</style>
