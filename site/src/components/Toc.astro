---
// Floating contents box (right column on wide screens, inline on phones).
interface Props { items: [string, string][]; }
const { items } = Astro.props;
---

<nav class="toc" aria-label="Contents">
  <b>Contents</b>
  <ol>{items.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
</nav>
