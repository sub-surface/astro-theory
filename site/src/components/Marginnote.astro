---
interface Props {
  id?: string;
}

const { id } = Astro.props;
const uniqueId = id || `mn-${Math.random().toString(36).substring(2, 9)}`;
---

<span class="marginnote-wrapper">
  <input type="checkbox" id={uniqueId} class="marginnote-toggle" aria-label="Toggle margin note" />
  <label for={uniqueId} class="marginnote-toggle-label" title="Click to view note">
    &#8853;
  </label>
  <span class="marginnote">
    <slot />
  </span>
</span>
