---

<div class="taxonomy-explorer interactive-panel">
  <div class="interactive-header">
    <div class="interactive-title">// ENCYCLOPAEDIC SUB-FIELD TAXONOMY & GAP MATRIX</div>
    <div class="interactive-status">[MASTER WORK INDEX]</div>
  </div>

  <p class="sim-intro">
    Celestrium's long-term scientific mission is to conduct rigorous, publishable research across every primary sub-discipline of astronomy, astrophysics, and cosmology. Filter below by status or domain to inspect active experiments, pre-flight preparations, and targeted research gaps.
  </p>

  <!-- Filter Bar -->
  <div class="filter-bar">
    <div class="filter-row">
      <span class="filter-label">STATUS:</span>
      <div class="filter-pills" id="status-filters">
        <button type="button" class="pill-btn pill-active" data-status="ALL">ALL STATUSES</button>
        <button type="button" class="pill-btn" data-status="ACTIVE">● ACTIVE RESEARCH</button>
        <button type="button" class="pill-btn" data-status="IN_PREP">◐ PRE-FLIGHT / PREP</button>
        <button type="button" class="pill-btn" data-status="GAP">○ OPEN GAPS</button>
      </div>
    </div>

    <div class="filter-row">
      <span class="filter-label">DOMAIN:</span>
      <div class="filter-pills" id="domain-filters">
        <button type="button" class="pill-btn pill-active" data-domain="ALL">ALL DOMAINS</button>
        <button type="button" class="pill-btn" data-domain="Cosmology">Cosmology</button>
        <button type="button" class="pill-btn" data-domain="High-Energy">High-Energy & GW</button>
        <button type="button" class="pill-btn" data-domain="Radio & Sub-mm">Radio & Sub-mm</button>
        <button type="button" class="pill-btn" data-domain="Stellar & Galactic">Stellar & Galactic</button>
        <button type="button" class="pill-btn" data-domain="Planetary & Solar">Planetary & Solar</button>
        <button type="button" class="pill-btn" data-domain="AI & Methods">AI & Methods</button>
      </div>
    </div>

    <div class="search-row">
      <input type="text" id="tax-search" placeholder="Filter by keyword (e.g. 21cm, MOND, kilonova, exoplanet, radio, neutrino)..." class="search-input" />
    </div>
  </div>

  <!-- Taxonomy Cards List -->
  <div class="tax-list" id="tax-container">
    {disciplines.map((d) => (
      <div 
        class="tax-card" 
        data-status={d.status} 
        data-domain={d.domain} 
        data-search={`${d.name} ${d.domain} ${d.experiments} ${d.surveys} ${d.findings} ${d.gap}`.toLowerCase()}
      >
        <div class="card-header">
          <div class="card-title-group">
            <span class="card-domain">{d.domain}</span>
            <h4 class="card-name">{d.name}</h4>
          </div>
          <span class={`status-badge status-${d.status.toLowerCase()}`}>
            {d.statusText}
          </span>
        </div>

        <div class="card-body">
          <div class="card-meta-line">
            <span class="meta-k">SURVEYS / TELESCOPES:</span>
            <span class="meta-v">{d.surveys}</span>
          </div>

          <div class="card-meta-line">
            <span class="meta-k">CELESTRIUM WORK:</span>
            <span class="meta-v">{d.experiments}</span>
          </div>

          <div class="card-detail-block">
            <div class="detail-label">// EMPIRICAL FINDINGS & CAPABILITIES</div>
            <p class="detail-p">{d.findings}</p>
          </div>

          <div class="card-gap-block">
            <div class="gap-label">// OPEN SCIENTIFIC GAP & NEXT FRONTIER</div>
            <p class="gap-p">{d.gap}</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="tax-footer">
    <span class="sim-note">
      * Complete encyclopaedic audit permanently maintained in <code>docs/research/astronomy-work-index.md</code>.
    </span>
  </div>
</div>

<script is:inline>
  (function() {
    var statusBtns = document.querySelectorAll('#status-filters .pill-btn');
    var domainBtns = document.querySelectorAll('#domain-filters .pill-btn');
    var searchInput = document.getElementById('tax-search');
    var cards = document.querySelectorAll('.tax-card');

    var currentStatus = 'ALL';
    var currentDomain = 'ALL';
    var currentQuery = '';

    function filterCards() {
      cards.forEach(function(card) {
        var cardStatus = card.getAttribute('data-status');
        var cardDomain = card.getAttribute('data-domain');
        var cardSearch = card.getAttribute('data-search');

        var statusMatch = (currentStatus === 'ALL' || cardStatus === currentStatus);
        var domainMatch = (currentDomain === 'ALL' || cardDomain.indexOf(currentDomain) !== -1);
        var searchMatch = (!currentQuery || cardSearch.indexOf(currentQuery) !== -1);

        if (statusMatch && domainMatch && searchMatch) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    statusBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        statusBtns.forEach(function(b) { b.classList.remove('pill-active'); });
        btn.classList.add('pill-active');
        currentStatus = btn.getAttribute('data-status');
        filterCards();
      });
    });

    domainBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        domainBtns.forEach(function(b) { b.classList.remove('pill-active'); });
        btn.classList.add('pill-active');
        currentDomain = btn.getAttribute('data-domain');
        filterCards();
      });
    });

    searchInput.addEventListener('input', function() {
      currentQuery = searchInput.value.toLowerCase().trim();
      filterCards();
    });
  })();
</script>

