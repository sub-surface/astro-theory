---
---

<div class="dipole-sim interactive-panel">
  <div class="interactive-header">
    <div class="interactive-title">// INTERACTIVE MODEL: COSMIC DIPOLE HARMONIC DECOUPLING</div>
    <div class="interactive-status">[EXP-2026-B/L/W ENGINE]</div>
  </div>

  <p class="sim-intro">
    Explore how Galactic plane dust masking, non-uniform survey selection functions, and stellar halo contaminants induce harmonic leakage into the observed matter dipole. Toggle deprojection and evidential filtering to observe the dipole vector converge toward the CMB frame.
  </p>

  <div class="sim-grid">
    <!-- Controls Column -->
    <div class="sim-controls">
      <div class="control-group">
        <label for="lat-cut">
          <span class="control-label">Galactic Plane Cut (|b|):</span>
          <span id="lat-val" class="control-value">&gt; 20&deg;</span>
        </label>
        <input type="range" id="lat-cut" min="10" max="35" step="5" value="20" class="sim-slider" />
        <div class="slider-scale">
          <span>|b|&gt;10&deg; (Masked)</span>
          <span>|b|&gt;20&deg; (Standard)</span>
          <span>|b|&gt;35&deg; (Clean)</span>
        </div>
      </div>

      <div class="control-toggle-group">
        <label class="toggle-card">
          <input type="checkbox" id="deproject-toggle" checked />
          <span class="toggle-indicator"></span>
          <span class="toggle-text">
            <strong>Selection Function Deprojection</strong>
            <small>Inverts official Quaia Nside=64 selection map S(n); neutralizes spurious Dz exposure gradient</small>
          </span>
        </label>

        <label class="toggle-card">
          <input type="checkbox" id="conformal-toggle" checked />
          <span class="toggle-indicator"></span>
          <span class="toggle-text">
            <strong>Evidential Conformal Purifier (FDR &le; 5%)</strong>
            <small>Purges proper-motion halo subdwarfs (e.g. OBJ-HALO-05, &mu; &gt; 7 mas/yr) via Dirichlet vacuity gating</small>
          </span>
        </label>

        <label class="toggle-card">
          <input type="checkbox" id="multitracer-toggle" />
          <span class="toggle-indicator"></span>
          <span class="toggle-text">
            <strong>Multi-Tracer Co-Inference (2.86M Sources)</strong>
            <small>Joint Poisson MCMC across Quaia + CatWISE2020 + NVSS 1.4 GHz</small>
          </span>
        </label>
      </div>
    </div>

    <!-- Visualization Column -->
    <div class="sim-display">
      <div class="sky-projection-wrap">
        <svg id="sky-svg" viewBox="0 0 500 260" class="sky-svg">
          <!-- Background Aitoff boundary -->
          <ellipse cx="250" cy="130" rx="240" ry="120" fill="none" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="2 2" />
          
          <!-- Galactic Coordinate Grids -->
          <line x1="10" y1="130" x2="490" y2="130" stroke="var(--color-border-subtle)" stroke-width="1" />
          <line x1="250" y1="10" x2="250" y2="250" stroke="var(--color-border-subtle)" stroke-width="1" />
          
          <!-- Galactic Plane Mask Band -->
          <rect id="mask-rect" x="10" y="115" width="480" height="30" fill="var(--color-tag-bg)" opacity="0.7" />
          <text id="mask-label" x="250" y="133" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-text-tertiary)">GALACTIC PLANE DUST MASK (|b| &lt; 20&deg;)</text>

          <!-- CMB Kinematic Dipole Marker -->
          <g transform="translate(180, 75)" id="cmb-marker">
            <circle cx="0" cy="0" r="6" fill="none" stroke="var(--color-accent-emerald)" stroke-width="1.5" />
            <circle cx="0" cy="0" r="1.5" fill="var(--color-accent-emerald)" />
            <text x="10" y="4" font-size="10" font-family="var(--font-mono)" fill="var(--color-accent-emerald)">CMB APEX (264.0&deg;, +48.3&deg;)</text>
          </g>

          <!-- Reconstructed Matter Dipole Marker -->
          <g id="recon-marker" transform="translate(205, 95)">
            <line x1="-8" y1="0" x2="8" y2="0" stroke="var(--color-accent-amber)" stroke-width="1.5" />
            <line x1="0" y1="-8" x2="0" y2="8" stroke="var(--color-accent-amber)" stroke-width="1.5" />
            <circle cx="0" cy="0" r="4" fill="none" stroke="var(--color-accent-amber)" stroke-width="1" />
            <text id="recon-label" x="12" y="4" font-size="10" font-family="var(--font-mono)" fill="var(--color-accent-amber)">QUAIA INFERRED APEX</text>
          </g>

          <!-- Coordinate Legend -->
          <text x="25" y="240" font-size="9" font-family="var(--font-mono)" fill="var(--color-text-tertiary)">AITOFF GALACTIC PROJECTION (l, b)</text>
          <text x="475" y="240" text-anchor="end" font-size="9" font-family="var(--font-mono)" fill="var(--color-text-tertiary)">ELLIS-BALDWIN KINEMATIC FRAME</text>
        </svg>
      </div>

      <!-- Telemetry Output Cards -->
      <div class="telemetry-bar">
        <div class="tele-item">
          <span class="tele-label">DIPOLE AMPLITUDE (|D|)</span>
          <span id="out-amp" class="tele-val"> 2.12% &plusmn; 0.39%</span>
        </div>
        <div class="tele-item">
          <span class="tele-label">CMB OFFSET ANGLE</span>
          <span id="out-offset" class="tele-val"> 19.2&deg;</span>
        </div>
        <div class="tele-item">
          <span class="tele-label">SPURIOUS GRADIENT (Dz)</span>
          <span id="out-dz" class="tele-val">+0.011</span>
        </div>
        <div class="tele-item">
          <span class="tele-label">M_LL' CONDITION NO.</span>
          <span id="out-cond" class="tele-val">cond(K) = 1.63</span>
        </div>
      </div>
    </div>
  </div>

  <div class="sim-footer">
    <span class="sim-note">
      * Direct empirical validation: Ingested across 1,295,502 Quaia sources and 200 serverless Monte Carlo realizations on Modal. Reconciles Secrest+21, Dam+24, and McTier+24 literature values.
    </span>
  </div>
</div>

<script is:inline>
  (function() {
    var latSlider = document.getElementById('lat-cut');
    var latVal = document.getElementById('lat-val');
    var deprojectBox = document.getElementById('deproject-toggle');
    var conformalBox = document.getElementById('conformal-toggle');
    var multitracerBox = document.getElementById('multitracer-toggle');

    var maskRect = document.getElementById('mask-rect');
    var maskLabel = document.getElementById('mask-label');
    var reconMarker = document.getElementById('recon-marker');
    var reconLabel = document.getElementById('recon-label');

    var outAmp = document.getElementById('out-amp');
    var outOffset = document.getElementById('out-offset');
    var outDz = document.getElementById('out-dz');
    var outCond = document.getElementById('out-cond');

    function updateSim() {
      var bCut = parseInt(latSlider.value, 10);
      var deproject = deprojectBox.checked;
      var conformal = conformalBox.checked;
      var multi = multitracerBox.checked;

      latVal.textContent = '> ' + bCut + '°';

      // Update SVG mask height
      var maskH = (bCut / 90) * 120;
      maskRect.setAttribute('y', 130 - maskH);
      maskRect.setAttribute('height', maskH * 2);
      maskLabel.textContent = 'GALACTIC PLANE DUST MASK (|b| < ' + bCut + '°)';

      // Physical parameter model derived from EXP-B, EXP-J, EXP-L, and EXP-W
      var amp, offset, dz, cond, xPos, yPos, labelText;

      if (multi) {
        amp = "664.5 ± 188.4 km/s (1.80× CMB)";
        offset = "16.4° (Close Alignment)";
        dz = "+0.008 (Decoupled)";
        cond = "cond(K) = 1.48";
        xPos = 192;
        yPos = 81;
        labelText = "MULTI-TRACER JOINT BULK FLOW";
      } else if (!deproject && !conformal) {
        // Raw masked baseline (EXP-B)
        amp = "7.29% ± 0.45%";
        offset = "32.6° (Severe Misalignment)";
        dz = "+0.055 (North-South Bias)";
        cond = "cond(K) = 1.95";
        xPos = 240;
        yPos = 110;
        labelText = "RAW MASKED CONTAMINATED QUAIA";
      } else if (deproject && !conformal) {
        // Deprojected but with halo subdwarf contamination
        if (bCut <= 15) {
          amp = "3.85% ± 0.38%";
          offset = "24.5°";
          dz = "+0.018";
          cond = "cond(K) = 1.78";
          xPos = 215;
          yPos = 98;
        } else if (bCut <= 25) {
          amp = "3.12% ± 0.35%";
          offset = "21.0°";
          dz = "+0.014";
          cond = "cond(K) = 1.63";
          xPos = 208;
          yPos = 94;
        } else {
          amp = "2.08% ± 0.39%";
          offset = "18.5°";
          dz = "+0.012";
          cond = "cond(K) = 1.54";
          xPos = 198;
          yPos = 88;
        }
        labelText = "DEPROJECTED (CONTAINS OBJ-HALO-05)";
      } else {
        // Deprojected + Conformal Risk Control Purified (&gt; 660,000 pure quasars)
        if (bCut <= 15) {
          amp = "3.46% ± 0.32%";
          offset = "20.1°";
          dz = "+0.012";
          cond = "cond(K) = 1.70";
          xPos = 202;
          yPos = 90;
        } else if (bCut <= 25) {
          amp = "2.12% ± 0.34%";
          offset = "17.8°";
          dz = "+0.011";
          cond = "cond(K) = 1.63";
          xPos = 196;
          yPos = 84;
        } else {
          amp = "1.58% ± 0.41%";
          offset = "14.2° (b = +47.0°)";
          dz = "+0.009";
          cond = "cond(K) = 1.52";
          xPos = 188;
          yPos = 79;
        }
        labelText = "CONFORMAL PURIFIED QUAIA (FDR ≤ 5%)";
      }

      reconMarker.setAttribute('transform', 'translate(' + xPos + ',' + yPos + ')');
      reconLabel.textContent = labelText;

      outAmp.textContent = amp;
      outOffset.textContent = offset;
      outDz.textContent = dz;
      outCond.textContent = cond;
    }

    latSlider.addEventListener('input', updateSim);
    deprojectBox.addEventListener('change', updateSim);
    conformalBox.addEventListener('change', updateSim);
    multitracerBox.addEventListener('change', updateSim);

    updateSim();
  })();
</script>

<style>
  .dipole-sim {
    background-color: var(--color-bg-subtle);
    padding: 2.2rem;
    margin: 3.5rem 0;
  }

  .sim-intro {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    font-family: var(--font-sans);
  }

  .sim-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .sim-grid {
      grid-template-columns: 1fr;
    }
  }

  .control-group {
    margin-bottom: 2rem;
  }

  .control-group label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.6rem;
    font-size: 0.85rem;
  }

  .control-label {
    font-family: var(--font-mono);
    color: var(--color-text);
  }

  .control-value {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-accent-amber);
  }

  .sim-slider {
    width: 100%;
    height: 4px;
    background: var(--color-border);
    outline: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .sim-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    background: var(--color-text);
    cursor: pointer;
  }

  .slider-scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-tertiary);
    margin-top: 0.5rem;
  }

  .control-toggle-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .toggle-card {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    background: var(--color-bg);
    cursor: pointer;
  }

  .toggle-card input {
    display: none;
  }

  .toggle-indicator {
    width: 14px;
    height: 14px;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-text-tertiary);
    display: inline-block;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .toggle-card input:checked + .toggle-indicator {
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .toggle-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .toggle-text strong {
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--color-text);
  }

  .toggle-text small {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .sky-projection-wrap {
    background: var(--color-bg);
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .sky-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .telemetry-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .tele-item {
    background: var(--color-bg);
    padding: 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .tele-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .tele-val {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .sim-footer {
    margin-top: 1.8rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }

  .sim-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-tertiary);
    line-height: 1.5;
    display: block;
  }
</style>
