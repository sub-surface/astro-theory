---
interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  ogImage?: string;
}

const {
  title,
  description = 'Celestrium: astrophysics notebook of Leon and Claude. Experiments, their audit status, and figures.',
  wide = false,
  ogImage = '/fig/tcrb/tcrb_uv_xray_track.png',
} = Astro.props;

import { sha, dirty, pushed, commitUrl, builtOn } from '../build-info';

const pageTitle = title ? `${title} - Celestrium` : 'Celestrium';
const site = Astro.site || 'https://astro.subsurfaces.net';
const canonicalUrl = new URL(Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" type="application/atom+xml" title="Celestrium: what changed" href="/feed.xml" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // apply a saved theme before first paint (no flash); storage can be blocked, so fail quietly
      try { const t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <style is:global>
      :root {
        --bg: #ffffff; --fg: #000000; --muted: #444444; --rule: #808080; --faint: #c0c0c0;
        --link: #0000ee; --visited: #551a8b; --th: #e0e0e0; --box: #f4f4f4; --notice: #ffffcc; --notice-rule: #c8b400;
        --ok: #ccffcc; --rerun: #ffffcc; --syn: #e8e8e8; --no: #ffcccc;
        --uv: #1f3fbf; --xr: #b35900; --opt: #222222; --old: #a0522d; --alert: #cc0000; --band: rgba(31, 63, 191, 0.07); --grid: #e4e4e4;
        color-scheme: light;
      }
      /* dark: follows the OS unless the visitor picked a theme with the toggle (data-theme on <html>) */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #121212; --fg: #e8e6e3; --muted: #b0aca6; --rule: #5a5a5a; --faint: #3a3a3a;
          --link: #8cb4ff; --visited: #c9a3ff; --th: #262626; --box: #1b1b1b; --notice: #2b2810; --notice-rule: #8a7a10;
          --ok: #1d3a1d; --rerun: #393612; --syn: #2a2a2a; --no: #4a1d1d;
          --uv: #8cb4ff; --xr: #f0a050; --opt: #e8e6e3; --old: #e0a070; --alert: #ff6b6b; --band: rgba(140, 180, 255, 0.08); --grid: #2a2a2a;
          color-scheme: dark;
        }
      }
      :root[data-theme="dark"] {
        --bg: #121212; --fg: #e8e6e3; --muted: #b0aca6; --rule: #5a5a5a; --faint: #3a3a3a;
        --link: #8cb4ff; --visited: #c9a3ff; --th: #262626; --box: #1b1b1b; --notice: #2b2810; --notice-rule: #8a7a10;
        --ok: #1d3a1d; --rerun: #393612; --syn: #2a2a2a; --no: #4a1d1d;
        --uv: #8cb4ff; --xr: #f0a050; --opt: #e8e6e3; --old: #e0a070; --alert: #ff6b6b; --band: rgba(140, 180, 255, 0.08); --grid: #2a2a2a;
        color-scheme: dark;
      }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        position: relative;
        background: var(--bg);
        color: var(--fg);
        font-family: "Times New Roman", Times, serif;
        font-size: 17px;
        line-height: 1.45;
        max-width: 46em;
        margin: 0 auto;
        padding: 1em 16px 3em;
      }
      body.wide { max-width: 62em; }
      a { color: var(--link); }
      a:visited { color: var(--visited); }
      a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
      h1 { font-size: 2em; margin: 0.4em 0 0.1em; padding-right: 1.4em; text-wrap: balance; }
      h2 { font-size: 1.35em; margin: 1.8em 0 0.5em; text-wrap: balance; border-bottom: 1px solid var(--faint); padding-bottom: 0.15em; }
      h3 { font-size: 1.1em; margin: 1.4em 0 0.3em; }
      h2:target { background: var(--notice); }
      p { margin: 0.6em 0; }
      hr { border: 0; border-top: 1px solid var(--rule); margin: 1.5em 0; }
      code, tt, .st, .mono { font-family: "Courier New", Courier, monospace; font-size: 0.88em; font-variant-numeric: tabular-nums; }
      .wrap { overflow-x: auto; }
      table { border-collapse: collapse; font-size: 0.92em; font-variant-numeric: tabular-nums; }
      th, td { border: 1px solid var(--rule); padding: 4px 6px; vertical-align: top; text-align: left; }
      th { background: var(--th); }
      .ledger td img { width: 120px; max-width: none; display: block; }
      figure { margin: 1.2em 0; min-width: 0; }
      figure img { max-width: 100%; height: auto; border: 1px solid var(--faint); display: block; background: #fff; }
      figcaption { font-size: 0.92em; margin-top: 0.3em; }
      .small { font-size: 0.85em; color: var(--muted); }
      .ok { background: var(--ok); }
      .rerun { background: var(--rerun); }
      .syn { background: var(--syn); }
      .no { background: var(--no); }
      .plan { background: transparent; }
      @media (max-width: 600px) { .ledger th:nth-child(3), .ledger td:nth-child(3) { display: none; } .ledger td img { width: 80px; } }
      .theme-btn { position: absolute; top: calc(0.6em + env(safe-area-inset-top, 0px)); right: 16px; display: inline-flex; align-items: center; justify-content: center;
        width: 2em; height: 2em; padding: 0; color: var(--fg); background: var(--th); border: 2px outset var(--faint); cursor: pointer; }
      .theme-btn:active { border-style: inset; }
      .theme-btn svg { width: 1.1em; height: 1.1em; }
      .theme-btn .sun { display: none; }
      :root[data-theme="dark"] .theme-btn .sun { display: block; }
      :root[data-theme="dark"] .theme-btn .moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .theme-btn .sun { display: block; }
        :root:not([data-theme="light"]) .theme-btn .moon { display: none; }
      }
      /* shared page furniture (object pages, hub) */
      .notice { background: var(--notice); border: 1px solid var(--notice-rule); padding: 0.6em 0.8em; margin: 1em 0; }
      .toc { border: 1px solid var(--rule); background: var(--box); padding: 0.5em 1em 0.4em; margin: 1em 0; font-size: 0.95em; width: fit-content; max-width: 100%; }
      .toc ol { margin: 0.3em 0 0.2em; padding-left: 1.6em; columns: 2; column-gap: 2.5em; }
      @media (min-width: 900px) { .toc { float: right; margin: 0 0 1em 1.5em; } .toc ol { columns: 1; } }
      @media (max-width: 480px) { .toc ol { columns: 1; } }
      h2 { clear: both; }
      .sheet td:first-child { white-space: nowrap; }
      @media (max-width: 560px) {
        .stack th { display: none; }
        .stack, .stack tbody, .stack tr, .stack td { display: block; width: auto; }
        .stack tr { border: 1px solid var(--rule); padding: 4px 8px; }
        .stack tr + tr { border-top: 0; }
        .stack tr:has(th) { display: none; }
        .stack tr:has(th) + tr { border-top: 1px solid var(--rule); }
        .stack td { border: 0; padding: 0; white-space: normal !important; }
        .stack td:first-child { font-weight: bold; }
        .sheet.stack td:last-child { font-size: 0.85em; color: var(--muted); }
      }
      .pair { display: grid; gap: 0 1.5em; }
      .pair > * { min-width: 0; }
      @media (min-width: 760px) { .pair { grid-template-columns: 1.1fr 1fr; align-items: start; } }
      .callout { border-left: 4px solid var(--alert); padding: 0.2em 0 0.2em 0.9em; margin: 1em 0; }
      .panel { border: 1px solid var(--rule); background: var(--box); padding: 0.5em 0.6em; margin: 1em 0; }
      .site-foot { margin-top: 2.5em; }
      .site-foot a { color: var(--muted); }
    </style>
  </head>
  <body class={wide ? 'wide' : ''}>
    <button class="theme-btn" id="theme-btn" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6a8.5 8.5 0 1 0 11 11z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/></g></svg>
    </button>
    <slot />
    <footer class="small site-foot">
      <hr />
      <a href="/">Celestrium</a> · Leon &amp; Claude, 2026 · figures may be reused with credit ·
      built {builtOn} from <a href={commitUrl} title={pushed ? 'source commit on GitHub' : 'commit not yet pushed; links to the history'}><code>{sha || 'unknown'}{dirty ? '+' : ''}</code></a>{dirty && ' (with uncommitted changes)'} ·
      <a href="https://subsurfaces.net">subsurfaces.net</a>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-btn');
        var root = document.documentElement;
        var isDark = function () {
          return root.dataset.theme ? root.dataset.theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        };
        var label = function () { btn.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode'); btn.title = btn.getAttribute('aria-label'); };
        label();
        // copy buttons: <button class="copy" data-copy="...">
        document.addEventListener('click', function (ev) {
          var c = ev.target.closest && ev.target.closest('button.copy');
          if (!c) return;
          var done = function (ok) { var t = c.textContent; c.textContent = ok ? 'copied' : 'select and copy'; setTimeout(function () { c.textContent = t; }, 1500); };
          if (navigator.clipboard) navigator.clipboard.writeText(c.dataset.copy).then(function () { done(true); }, function () { done(false); });
          else done(false);
        });
        // no autoplaying animations for visitors who ask for reduced motion
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('video[autoplay]').forEach(function (v) { v.removeAttribute('autoplay'); v.pause(); v.controls = true; });
        }
        btn.addEventListener('click', function () {
          var next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          label();
        });
      })();
    </script>
  </body>
</html>
