---
interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Celestrium: astrophysics notebook of Leon and Claude. Experiments, their audit status, and figures.',
} = Astro.props;

const pageTitle = title ? `${title} - Celestrium` : 'Celestrium';
const site = Astro.site || 'https://astro.subsurfaces.net';
const canonicalUrl = new URL(Astro.url.pathname, site);
const ogImageUrl = new URL('/fig/tcrb/tcrb_uv_xray_track.png', site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta name="twitter:card" content="summary" />
    <style is:global>
      :root { color-scheme: light; }
      body {
        background: #ffffff;
        color: #000000;
        font-family: "Times New Roman", Times, serif;
        font-size: 17px;
        line-height: 1.4;
        max-width: 46em;
        margin: 0 auto;
        padding: 1em 16px 3em;
      }
      a { color: #0000ee; }
      a:visited { color: #551a8b; }
      h1 { font-size: 2em; margin: 0.4em 0 0.1em; }
      h2 { font-size: 1.35em; margin-top: 1.6em; }
      h3 { font-size: 1.1em; margin: 1.4em 0 0.3em; }
      hr { border: 0; border-top: 1px solid #808080; margin: 1.5em 0; }
      code, tt, .st { font-family: "Courier New", Courier, monospace; font-size: 0.88em; }
      .wrap { overflow-x: auto; }
      table { border-collapse: collapse; font-size: 0.92em; }
      th, td { border: 1px solid #808080; padding: 4px 6px; vertical-align: top; text-align: left; }
      th { background: #e0e0e0; }
      td img { width: 120px; max-width: none; display: block; }
      figure { margin: 1.2em 0; }
      figure img { max-width: 100%; height: auto; border: 1px solid #c0c0c0; display: block; }
      figcaption { font-size: 0.92em; margin-top: 0.3em; }
      .small { font-size: 0.85em; color: #404040; }
      .ok { background: #ccffcc; }
      .rerun { background: #ffffcc; }
      .syn { background: #e8e8e8; }
      .no { background: #ffcccc; }
      .plan { background: #ffffff; }
      @media (max-width: 600px) { th:nth-child(3), td:nth-child(3) { display: none; } td img { width: 80px; } }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
