---
import Base from '../layouts/Base.astro';

const updated = '14 October 2026';

// Status classes: ok = sound, rerun = needs rerun, syn = synthetic only, no = withdrawn / not demonstrated, plan = planned
const experiments = [
  { id: 'Y', title: 'T Coronae Borealis: multi-wavelength status and accretion inversion', data: 'AAVSO, ANS UBV, Swift UVOT/XRT, TESS', status: 'SOUND', cls: 'ok', note: 'See the T CrB section below.', fig: 'tcrb/tcrb_uv_xray_track.png' },
  { id: 'G', title: 'Live audit of ten archive pipelines', data: 'TAP, REST and FITS services', status: 'SOUND', cls: 'ok', note: 'All ten returned rows when checked.' },
  { id: 'I', title: 'Quaia selection-function and Galactic-cut survey', data: 'Quaia G20.5 + SIMBAD', status: 'SOUND (descriptive)', cls: 'ok', note: 'Dipole amplitude stays in the published 2.1-3.1% band. The grid script it cites is missing.', fig: 'remarkable_objects_discovery_gallery.png' },
  { id: 'K', title: 'Dipole estimator injection-recovery', data: 'full-sky mocks', status: 'SOUND (synthetic validation)', cls: 'ok', note: 'Estimator response b = 0.975 +/- 0.021. A method test; says nothing about the sky.', fig: 'dipole_injection_recovery_benchmark.png' },
  { id: 'B', title: 'Quaia quasar dipole deconvolution', data: 'Quaia G20.5, 1.3M quasars', status: 'NEEDS RERUN', cls: 'rerun', note: 'Classifier used Galactic (l, b) as features; errors not checked on mocks.', fig: 'experiment_b_quaia_dipole_deconvolution.png' },
  { id: 'F', title: '12-class source classifier', data: 'Gaia DR3 + Quaia + unWISE', status: 'NEEDS RERUN', cls: 'rerun', note: '7 of 12 classes synthetic; labels leak into the photometry.' },
  { id: 'H', title: 'Calibrated decisions ("rewarding doubt")', data: 'EXP-F dataset', status: 'NEEDS RERUN', cls: 'rerun', note: 'Inherits the EXP-F label leak; calibration measured in-sample.', fig: 'rlcd_decision_calibration_benchmark.png' },
  { id: 'J', title: 'Full-catalogue conformal filtering', data: 'Quaia, 1.3M sources', status: 'NEEDS RERUN', cls: 'rerun', note: 'Uses (l, b) as features; the threshold was hard-coded, so the FDR bound is unsupported.' },
  { id: 'L', title: 'Quaia selection deprojection', data: 'Quaia selection map', status: 'NEEDS RERUN', cls: 'rerun', note: 'Raw-sample deprojection stands; the purified branch cancels its own purification.', fig: 'quaia_selection_deprojection_progression.png' },
  { id: 'O', title: '10,000-mock null test of the dipole', data: 'LCDM kinematic mocks', status: 'NEEDS RERUN', cls: 'rerun', note: 'Null ignores clustering; p < 1e-4 is the Monte-Carlo floor.', fig: 'large_null_dipole_monte_carlo.png' },
  { id: 'P', title: 'MCMC dipole parameter estimation', data: 'Quaia, |b| > 20 deg', status: 'NEEDS RERUN', cls: 'rerun', note: 'Sampler converged (R-hat < 1.05); the Poisson likelihood overstates the evidence.', fig: 'bayesian_mcmc_dipole_posteriors.png' },
  { id: 'X', title: 'Fast radio burst triage', data: 'CHIME/FRB Catalog 1', status: 'NEEDS RERUN', cls: 'rerun', note: 'Labels were functions of the inputs; the classifier learned the rule.', fig: 'experiment_x_frb_triage.png' },
  { id: 'A', title: 'Real-time alert triage', data: 'simulated alert stream', status: 'SYNTHETIC ONLY', cls: 'syn', note: 'Latency measured on simulated alerts only.', fig: 'experiment_a_streaming_triage.png' },
  { id: 'D', title: 'Conformal contamination bounds', data: 'Beta-distributed synthetic scores', status: 'SYNTHETIC ONLY', cls: 'syn', note: 'Quaia has no truth labels; scores were synthetic.', fig: 'experiment_d_conformal_risk_control.png' },
  { id: 'Q', title: 'Exoplanet transit / RV triage', data: 'simulated', status: 'SYNTHETIC ONLY', cls: 'syn', note: 'Classes separable by construction.', fig: 'experiment_q_exoplanet_triage.png' },
  { id: 'R', title: 'Multi-messenger counterpart triage', data: 'simulated GW + neutrino alerts', status: 'SYNTHETIC ONLY', cls: 'syn', note: 'Injected kilonovae; zero false alarms is the veto boundary.', fig: 'experiment_r_multimessenger_triage.png' },
  { id: 'S', title: 'z > 10 galaxy vs brown-dwarf discrimination', data: 'simulated', status: 'SYNTHETIC ONLY', cls: 'syn', note: 'No JWST or Euclid photometry read.', fig: 'experiment_s_cosmic_dawn_triage.png' },
  { id: 'T', title: 'Solar flare forecasting', data: 'simulated', status: 'SYNTHETIC ONLY', cls: 'syn', note: 'Perfect skill by generator construction.', fig: 'experiment_t_space_weather_triage.png' },
  { id: 'U', title: 'GW error-volume tiling', data: '100 simulated events', status: 'SYNTHETIC ONLY', cls: 'syn', note: '97% vs 89% recovery is within noise at n = 100.', fig: 'experiment_u_active_gw_tiling_benchmark.png' },
  { id: 'V', title: 'Cross-survey zero-point calibration', data: 'real SEDs, injected offsets', status: 'NOT DEMONSTRATED', cls: 'no', note: 'RMSE equals the injected scatter: no better than predicting zero.', fig: 'experiment_v_flow_cross_calibration.png' },
  { id: 'E', title: 'Cloud Monte Carlo null for the dipole', data: '200 HEALPix mocks', status: 'WITHDRAWN', cls: 'no', note: '200 draws cannot support p < 1e-5; mismatched mask.', fig: 'experiment_e_cloud_monte_carlo_null.png' },
  { id: 'M', title: 'Classifier sky hold-out', data: 'Galactic N vs S', status: 'WITHDRAWN', cls: 'no', note: 'Conclusion inverted: accuracy fell 88% to 55% on the held-out hemisphere.', fig: 'foundation_spatial_holdout_generalization.png' },
  { id: 'N', title: 'Telescope queue scheduling', data: 'simulated semesters', status: 'WITHDRAWN', cls: 'no', note: 'Screening read the true class from the simulation.', fig: 'rlcd_telescope_queue_scheduling.png' },
  { id: 'W', title: 'Multi-tracer dipole co-inference', data: 'Quaia, CatWISE, NVSS', status: 'WITHDRAWN', cls: 'no', note: 'The larger model fit worse than the nested one: a sampler failure.', fig: 'experiment_w_multi_tracer_coinference.png' },
  { id: '01', title: 'Euclid DR1 dipole recovery', data: 'Euclid DR1 Wide', status: 'PLANNED', cls: 'plan', note: 'Data release 21 Oct 2026.' },
  { id: '04', title: 'Active learning for spectroscopic fibres', data: 'DESI', status: 'PLANNED', cls: 'plan', note: 'No result yet.' },
  { id: '05', title: 'Zone-of-avoidance multi-wavelength fusion', data: 'eROSITA + CatWISE', status: 'PLANNED', cls: 'plan', note: 'No code or data yet.' },
];

const tcrb = [
  ['tcrb_panchromatic_lightcurve.png', 'Light curves 2005-2026: optical (AAVSO, Gaia), Swift UVOT ultraviolet and XRT X-ray. The 2016-2022 high state, the 2023 dip, and the September 2026 UV collapse.'],
  ['tcrb_uv_xray_track.png', 'UV against hard X-ray. In September 2026 UVM2 fell 2.05 mag in 30 days (12.12 to 14.17) while 2-10 keV X-rays rose. Unreported as of this page.'],
  ['tcrb_uv_dip_onsets.png', 'The 2023 and 2026 UV collapses aligned on their onsets, with hard X-rays below. A viscous disk with its supply cut fades at most 0.11 mag in 30 days; a 2-mag fade takes at least 288 days. So the inner disk changed state.'],
  ['tcrb_dips_overlay.png', 'The 1945-46 pre-eruption dip overlaid on today. Aligning on the 2023 dip is falsified; aligning on the 2026 collapse implies eruption near 2027.4.'],
  ['tcrb_accretion_inversion.png', 'Disk inversion. The inner edge moves from about 3 solar radii (quiescence) to 0.75-1 (2016-22 high state) and back to 2.7 (2023 dip, and now). The absolute accretion rate is not identified.'],
  ['tcrb_accretion_movie.gif', 'The inversion as a movie: the inner 8 solar radii, face-on, 2005-2026.'],
  ['tcrb_ephemeris.png', 'Orbital period 227.60 +/- 0.06 d from AAVSO V with the secular trend removed, and the ellipsoidal light curve.'],
  ['tcrb_roche_map.png', 'Roche geometry of the red giant and white dwarf.'],
  ['tcrb_orbit.gif', 'The binary through one orbit.'],
  ['tcrb_system_states.png', 'Rendered system in quiescence (2010), peak accretion (2016.3) and now (2026.75). Inclination 61 deg; colours are blackbody, brightness on a log-T scale.'],
  ['tcrb_tess_flicker.png', 'TESS sectors 24, 25, 51 and 78. No significant periodicity against red-noise simulations; the disputed ~6000 s signal is not seen.'],
  ['srn_family_uv_xray.png', 'The symbiotic recurrent-nova family. In quiescence RS Oph and V745 Sco are about 2,800 times more UV-luminous than T CrB.'],
  ['tcrb_parameter_forest.png', 'Published white-dwarf masses (converged on 1.29-1.37 solar masses) and inclinations, with our ellipsoidal-amplitude range shaded.'],
  ['tcrb_forecast_scoreboard.png', 'Fifteen published eruption windows; five have closed without an eruption. Ours: recurrence median 2028.1 (68%: 2027.1-2030.9) and the dip analogue near 2027.4.'],
  ['tcrb_literature_bibliometrics.png', '160 years of T CrB in ADS: 1,273 papers mention it, 213 refereed papers have it in the title or abstract.'],
];
---

<Base>
  <h1>Celestrium</h1>
  <p>An astrophysics notebook kept by Leon and Claude. Code and full write-ups are in the repository; this page lists what has been done and what each result is worth.</p>
  <p class="small">Last updated {updated}.</p>

  <p>[ <a href="#programmes">programmes</a> | <a href="#tcrb">T CrB</a> (<a href="/tcrb/">full page</a>) | <a href="#ledger">ledger</a> | <a href="#dates">dates</a> ]</p>

  <hr />

  <h2 id="programmes">Programmes</h2>
  <ul>
    <li><b>P1 Cosmic dipole.</b> Is the quasar number-count dipole consistent with our motion against the CMB? Machinery for Quaia, CatWISE and NVSS; Euclid DR1 arrives 21 Oct 2026. The earlier tension claims did not survive the audit.</li>
    <li><b>P2 Recurrent novae.</b> Watching <a href="/tcrb/">T Coronae Borealis</a> before its next eruption (seen in 1866 and 1946). Active.</li>
    <li><b>P3 Calibrated triage.</b> Classifiers that report honest uncertainty for follow-up decisions. Being rebuilt on real labelled data.</li>
    <li><b>P4 Theory threads.</b> Inflation after ACT DR6, primordial non-Gaussianity, physics-informed denoising. Ideas, no results yet.</li>
  </ul>

  <hr />

  <h2 id="tcrb">T Coronae Borealis (EXP-Y)</h2>
  <p>A recurrent nova 0.9 kpc away: a white dwarf of about 1.35 solar masses accreting from a red giant on a 227.6-day orbit. It erupted in 1866 and 1946 and is expected to erupt again within a few years. Data: AAVSO and ANS optical photometry, Swift UVOT and XRT (2005-2026), TESS, and 1,273 papers.</p>
  <p><b><a href="/tcrb/">Full page: T Coronae Borealis</a></b>, with interactive light curves, the 1945 comparison and the disk inversion. A selection of figures:</p>
  {tcrb.slice(0, 4).map(([f, cap]) => (
    <figure>
      <a href={`/fig/tcrb/${f}`}><img src={`/fig/tcrb/${f}`} alt={cap} loading="lazy" /></a>
      <figcaption>{cap}</figcaption>
    </figure>
  ))}

  <hr />

  <h2 id="ledger">Experiment ledger</h2>
  <p>Every experiment was re-checked against its code on 14 October 2026. Most results from June to September 2026 were on simulated data or had leaks; they are listed with their status, not hidden. Only rows marked SOUND are findings.</p>
  <p class="small">
    <span class="st ok">&nbsp;SOUND&nbsp;</span> real data, honest errors &nbsp;
    <span class="st rerun">&nbsp;NEEDS RERUN&nbsp;</span> real data, a flaw in the headline number &nbsp;
    <span class="st syn">&nbsp;SYNTHETIC ONLY&nbsp;</span> simulated benchmark &nbsp;
    <span class="st no">&nbsp;WITHDRAWN&nbsp;</span> effect absent or an artifact
  </p>
  <div class="wrap">
    <table class="ledger">
      <tr><th>EXP</th><th>What</th><th>Data</th><th>Status</th><th>Note</th><th>Figure</th></tr>
      {experiments.map((e) => (
        <tr>
          <td><tt>{e.id}</tt></td>
          <td>{e.title}</td>
          <td>{e.data}</td>
          <td class={`st ${e.cls}`}>{e.status}</td>
          <td>{e.note}</td>
          <td>{e.fig ? <a href={`/fig/${e.fig}`}><img src={`/fig/${e.fig}`} alt={`EXP-${e.id} figure`} loading="lazy" /></a> : '-'}</td>
        </tr>
      ))}
    </table>
  </div>

  <hr />

  <h2 id="dates">Dates</h2>
  <ul>
    <li><b>21 Oct 2026</b> Euclid DR1 public release.</li>
    <li><b>5-30 Nov 2026</b> T CrB UV-recovery test. If UVM2 brightens by 1 mag or more by 30 Nov with hard X-rays falling, the collapse was obscuration on the orbit; if it stays within 0.5 mag of quiescence, the accretion state changed.</li>
    <li><b>Dec 2026</b> Gaia DR4 (expected).</li>
    <li><b>Mar-Aug 2027</b> T CrB window from the 1946 analogue (centre 2027.4).</li>
    <li><b>Apr 2027</b> T CrB near solar conjunction.</li>
  </ul>

  <hr />
  <p class="small">Leon &amp; Claude, 2026. Figures are produced by the scripts in the repository and may be reused with credit.</p>
</Base>
