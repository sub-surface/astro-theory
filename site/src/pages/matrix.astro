---

<Base
  title="Research Matrix & Astronomical Notice Board"
  description="Explore Celestrium's live astronomical research matrix: tracking celestial phenomena, survey datasets, evidential methods, and empirical breakthroughs."
  activeNav="matrix"
  ogImage="/og-image.jpg"
>
  <div class="matrix-page-header">
    <div class="preface-cluster">
      <span class="ansi-tag">[REGISTRY:RESEARCH-MATRIX]</span>
      <span class="ansi-tag">10 RESEARCH AREAS</span>
      <span class="ansi-tag">STATUS SNAPSHOT</span>
    </div>

    <h1 class="page-title">Research Matrix & Notice Board</h1>
    <p class="page-desc">
      A status snapshot of research areas, datasets, and methods. “Audit required” means internal results are not yet released as validated findings; “proposed” means the experiment has not been established as complete. See the roadmap for release conditions.
      <Sidenote id="sn-matrix-nav" number="1">
        <strong>Status meanings:</strong> A completed run is not equivalent to independent validation, peer review, or a facility observation.
      </Sidenote>
    </p>

    <!-- Filter Bar -->
    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">DOMAIN:</span>
        <button class="filter-btn active" data-filter="domain" data-val="all" aria-pressed="true">All</button>
        <button class="filter-btn" data-filter="domain" data-val="Cosmology">Cosmology</button>
        <button class="filter-btn" data-filter="domain" data-val="Radio Transients">Radio & Transients</button>
        <button class="filter-btn" data-filter="domain" data-val="High-Energy">High-Energy & GW</button>
        <button class="filter-btn" data-filter="domain" data-val="Planetary Science">Exoplanets & Solar</button>
        <button class="filter-btn" data-filter="domain" data-val="Methods & ML">Methods</button>
      </div>

      <div class="filter-group">
        <span class="filter-label">STATUS:</span>
        <button class="filter-btn active" data-filter="status" data-val="all" aria-pressed="true">All</button>
        <button class="filter-btn" data-filter="status" data-val="AUDIT REQUIRED">Audit required</button>
        <button class="filter-btn" data-filter="status" data-val="BLOCKED">Blocked</button>
        <button class="filter-btn" data-filter="status" data-val="PROPOSED">Proposed</button>
        <button class="filter-btn" data-filter="status" data-val="IN PROGRESS">In Progress</button>
        <button class="filter-btn" data-filter="status" data-val="OPEN FRONTIER">Open Frontiers</button>
      </div>
    </div>

    <div class="incomplete-rule"></div>
  </div>

  <!-- Notice Board Grid -->
  <div class="matrix-grid" id="matrix-grid">
    {phenomena.map((item) => (
      <article 
        class="matrix-card" 
        data-domain={item.domain}
        data-status={item.status}
        id={item.id}
      >
        <div class="card-top-row">
          <span class="domain-tag">{item.domain}</span>
          <span class={`status-badge status-${item.status.toLowerCase().replace(/\s+/g, '-')}`}>
            <span class="status-pip"></span>
            {item.status}
          </span>
        </div>

        <h2 class="card-title">
            <a href="/roadmap/">{item.title}</a>
        </h2>

        <div class="card-scale-row">
          <span class="meta-label">PHYSICAL SCALE:</span>
          <span class="meta-val">{item.scale}</span>
        </div>

        <div class="card-dataset-box">
          <div class="dataset-header">
            <span class="meta-label">DATA / SCOPE:</span>
          </div>
          <p class="dataset-names">{item.dataset}</p>
        </div>

        <div class="card-section">
          <span class="section-subhead">OUR APPROACH</span>
          <p class="section-text">{item.approach}</p>
        </div>

        <div class="card-section highlight-box">
          <span class="section-subhead">RELEASE NOTE</span>
          <p class="section-text">Quantitative findings are withheld pending independent validation and reproducible artifacts. See the release roadmap for the required evidence.</p>
        </div>

        <div class="card-footer">
          <div class="cross-refs">
            {item.experiments.length > 0 && (
              <div class="ref-group">
                <span class="ref-title">EXP:</span>
                {item.experiments.map((e) => (
                  <span class="exp-badge">{e}</span>
                ))}
              </div>
            )}

          </div>

          <a href="/roadmap/" class="explore-btn">
            View release conditions &rarr;
          </a>
        </div>
      </article>
    ))}
  </div>
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.matrix-card');

    filterButtons.forEach(btn => {
      btn.setAttribute('aria-pressed', btn.classList.contains('active') ? 'true' : 'false');
    });

    let activeDomain = 'all';
    let activeStatus = 'all';

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-filter');
        const val = btn.getAttribute('data-val');

        // Toggle active style in button group
        document.querySelectorAll(`.filter-btn[data-filter="${type}"]`).forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        if (type === 'domain') activeDomain = val;
        if (type === 'status') activeStatus = val;

        cards.forEach(card => {
          const cardDomain = card.getAttribute('data-domain');
          const cardStatus = card.getAttribute('data-status');

          const domainMatch = activeDomain === 'all' || cardDomain.includes(activeDomain) || activeDomain.includes(cardDomain);
          const statusMatch = activeStatus === 'all' || cardStatus === activeStatus;

          if (domainMatch && statusMatch) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
