    .chart :global(.al) { fill: var(--alert); }
    .chart :global(.al-l) { stroke: var(--alert); stroke-dasharray: 4 3; }
    .chart :global(.old-l) { stroke: var(--old); fill: none; stroke-width: 1.8; }
    .chart :global(.old) { fill: var(--old); }
    .chart :global(.opt-l) { stroke: var(--opt); fill: none; stroke-width: 1.4; }
    .chart :global(.fg-l) { stroke: var(--fg); stroke-width: 1.3; }
    .chart :global(.cur) { stroke: var(--fg); stroke-width: 0.8; opacity: 0.6; }
    .chart :global(.lbl) { fill: var(--fg); paint-order: stroke; stroke: var(--box); stroke-width: 3px; stroke-linejoin: round; }
    .chart :global(.al-t) { fill: var(--alert); }
    .readout { font-size: 0.8em; color: var(--muted); min-height: 2.6em; margin-top: 0.3em; }
    ul { padding-left: 1.3em; }
    li { margin: 0.25em 0; }
  </style>

  <script is:inline define:vars={{ D }}>
    const $ = (id) => document.getElementById(id);
    const NOW = 2026.785;
    const NS = 'http://www.w3.org/2000/svg';
    const ticks = (a, b, step) => { const out = []; for (let t = Math.ceil(a / step) * step; t <= b + 1e-9; t += step) out.push(+t.toFixed(6)); return out; };
    const niceStep = (span, px, minPx) => { const raw = span * minPx / px; const p = 10 ** Math.floor(Math.log10(raw)); return [1, 2, 2.5, 5, 10].map((m) => m * p).find((s) => s >= raw); };

    // ---------- 1. light curves ----------
    let range = 'all';
    function lightcurves() {
      const el = $('lc'); const W = Math.max(300, el.clientWidth); const narrow = W < 560;
      const L = narrow ? 34 : 44, R = 10, T = 8, gap = 14, B = 22;
      const hV = narrow ? 80 : 100, hU = narrow ? 120 : 150, hX = narrow ? 80 : 100;
      const H = T + hV + gap + hU + gap + hX + B;
      const [x0, x1] = range === 'recent' ? [2022, 2026.95] : [2005, 2026.95];
      const sx = (t) => L + (t - x0) / (x1 - x0) * (W - L - R);
      const inWin = (a) => a.t.map((_, i) => i).filter((i) => a.t[i] >= x0 && a.t[i] <= x1);
      const V = D.V, U = D.uvm2, X = D.hard;
      const iV = inWin(V), iU = inWin(U), iX = inWin(X);
      const ext = (arr, ids, pad) => { const v = ids.map((i) => arr[i]); return [Math.min(...v) - pad, Math.max(...v) + pad]; };
      const [v0, v1] = ext(V.m, iV, 0.08), [u0, u1] = ext(U.m, iU, 0.3);
      const tV = T, tU = T + hV + gap, tX = tU + hU + gap;
      const syV = (m) => tV + (m - v0) / (v1 - v0) * hV;
      const syU = (m) => tU + (m - u0) / (u1 - u0) * hU;
      const xl0 = Math.log10(0.002), xl1 = Math.log10(0.3);
      const syX = (r) => tX + hX - (Math.log10(Math.min(0.3, Math.max(r, 0.002))) - xl0) / (xl1 - xl0) * hX;
      let s = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" xmlns="${NS}">`;
      // bands
      for (const [a, b, lab] of [[2015.1, 2023.3, 'high state'], [2023.3, 2024.4, '2023 dip']]) {
        if (b < x0) continue; const xa = sx(Math.max(a, x0)), xb = sx(Math.min(b, x1));
        s += `<rect class="band" x="${xa}" y="${T}" width="${xb - xa}" height="${tX + hX - T}"/>`;
        if (xb - xa > 46) s += `<text x="${(xa + xb) / 2}" y="${T + 11}" text-anchor="middle">${lab}</text>`;
      }
      // x grid
      const step = range === 'recent' ? (narrow ? 1 : 0.5) : (narrow ? 5 : 2);
      for (const t of ticks(x0, x1, step)) {
        s += `<line class="gr" x1="${sx(t)}" x2="${sx(t)}" y1="${T}" y2="${tX + hX}"/>`;
        s += `<text x="${sx(t)}" y="${H - 6}" text-anchor="middle">${Number.isInteger(t) ? t : t.toFixed(1)}</text>`;
      }
      // panel frames and y labels
      const ylab = (y, h, txt) => `<text class="lbl" x="${L + 5}" y="${y + h - 6}">${txt}</text>`;
      for (const [y, h] of [[tV, hV], [tU, hU], [tX, hX]]) s += `<rect class="ax" x="${L}" y="${y}" width="${W - L - R}" height="${h}"/>`;
      s += ylab(tV, hV, 'V mag') + ylab(tU, hU, 'UVM2 mag') + ylab(tX, hX, '2-10 keV, c/s');
      const sv = niceStep(v1 - v0, hV, 28);
      for (const m of ticks(v0 + 0.02, v1 - 0.02, sv)) s += `<text x="${L - 4}" y="${syV(m) + 4}" text-anchor="end">${m.toFixed(1)}</text>`;
      for (const m of ticks(u0 + 0.1, u1 - 0.1, niceStep(u1 - u0, hU, 30))) s += `<text x="${L - 4}" y="${syU(m) + 4}" text-anchor="end">${m}</text>`;
      for (const r of [0.01, 0.1]) s += `<text x="${L - 4}" y="${syX(r) + 4}" text-anchor="end">${r}</text>`;
      // points
      const rV = narrow ? 1.2 : 1.5;
      for (const i of iV) s += `<circle class="opt" cx="${sx(V.t[i]).toFixed(1)}" cy="${syV(V.m[i]).toFixed(1)}" r="${rV}" opacity="0.55"/>`;
      for (const i of iX) s += `<circle class="xr" cx="${sx(X.t[i]).toFixed(1)}" cy="${syX(X.r[i]).toFixed(1)}" r="2" opacity="0.8"/>`;
      for (const i of iU) {
        const late = U.t[i] > 2026.7, cx = sx(U.t[i]).toFixed(1), cy = syU(U.m[i]).toFixed(1);
        s += U.w[i] ? `<circle class="uvw" cx="${cx}" cy="${cy}" r="2.5"/>` : `<circle class="${late ? 'al' : 'uv'}" cx="${cx}" cy="${cy}" r="${late ? 4.5 : 2.5}"/>`;
      }
      s += `<line class="cur" id="lc-cur" x1="-10" x2="-10" y1="${T}" y2="${tX + hX}"/></svg>`;
      el.innerHTML = s;
      const svg = el.querySelector('svg'), cur = svg.querySelector('#lc-cur');
      const near = (a, ids, t) => ids.reduce((b, i) => (Math.abs(a.t[i] - t) < Math.abs(a.t[b] - t) ? i : b), ids[0]);
      const move = (ev) => {
        const r = svg.getBoundingClientRect(); const px = (ev.clientX - r.left) * W / r.width;
        const t = Math.min(x1, Math.max(x0, x0 + (px - L) / (W - L - R) * (x1 - x0)));
        cur.setAttribute('x1', sx(t)); cur.setAttribute('x2', sx(t));
        const a = near(V, iV, t), b = near(U, iU, t), c = near(X, iX, t);
        $('lc-read').textContent = `${t.toFixed(2)} | V ${V.m[a].toFixed(2)} (${V.t[a].toFixed(2)}) | UVM2 ${U.m[b].toFixed(2)} ± ${U.e[b].toFixed(2)} (${U.t[b].toFixed(2)}${U.w[b] ? ', wings' : ''}) | X ${X.r[c].toFixed(3)} c/s (${X.t[c].toFixed(2)})`;
      };
      svg.addEventListener('pointermove', move); svg.addEventListener('pointerdown', move);
    }
    document.querySelectorAll('[data-range]').forEach((b) => b.addEventListener('click', () => {
      range = b.dataset.range;
      document.querySelectorAll('[data-range]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      lightcurves();
    }));

    // ---------- 4. 1945 overlay ----------
    let onset = 2026.74;
    function overlay() {
      const O = D.overlay, el = $('ov'); const W = Math.max(300, el.clientWidth); const narrow = W < 560;
      const L = narrow ? 34 : 46, R = 10, T = 10, B = 34, H = narrow ? 240 : 300;
      const x0 = -3.0, x1 = 1.6, y0 = -0.45, y1 = 1.05;
      const sx = (t) => L + (t - x0) / (x1 - x0) * (W - L - R);
      const sy = (d) => T + (d - y0) / (y1 - y0) * (H - T - B);
      const shift = onset - O.on_old;
      let s = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" xmlns="${NS}">`;
      for (const t of ticks(x0, x1, narrow ? 1 : 0.5)) {
        s += `<line class="gr" x1="${sx(t)}" x2="${sx(t)}" y1="${T}" y2="${H - B}"/>`;
        s += `<text x="${sx(t)}" y="${H - B + 14}" text-anchor="middle">${t > 0 ? '+' : ''}${t}</text>`;
      }
      s += `<text x="${(L + W) / 2}" y="${H - 3}" text-anchor="middle">years relative to the 1946 eruption</text>`;
      for (const d of [-0.4, 0, 0.4, 0.8]) s += `<text x="${L - 4}" y="${sy(d) + 4}" text-anchor="end">${d > 0 ? '+' : ''}${d}</text>`;
      s += `<rect class="ax" x="${L}" y="${T}" width="${W - L - R}" height="${H - T - B}"/>`;
      s += `<text class="lbl" x="${L + 5}" y="${H - B - 6}">Δmag, fainter down</text>`;
      s += `<line class="fg-l" x1="${sx(0)}" x2="${sx(0)}" y1="${T}" y2="${H - B}"/><text class="lbl" x="${sx(0) + 4}" y="${T + 12}">1946 eruption</text>`;
      const today = NOW - shift - O.e46;
      if (today > x0 && today < x1) s += `<line class="al-l" x1="${sx(today)}" x2="${sx(today)}" y1="${T}" y2="${H - B}"/><text class="al-t" x="${sx(today) + 4}" y="${H - B - 6}">today</text>`;
      const inr = (x) => x > x0 && x < x1;
      const path = (xs, ys) => xs.map((x, i) => `${i ? 'L' : 'M'}${sx(x).toFixed(1)},${sy(ys[i]).toFixed(1)}`).join('');
      O.uv.t.forEach((t, i) => { const x = t - shift - O.e46; if (inr(x)) s += `<circle class="al" cx="${sx(x).toFixed(1)}" cy="${sy(Math.max(y0, Math.min(y1, O.uv.d[i]))).toFixed(1)}" r="1.8" opacity="0.5"/>`; });
      const nx = [], ny = []; O.new.t.forEach((t, i) => { const x = t - shift - O.e46; if (inr(x)) { nx.push(x); ny.push(O.new.d[i]); } });
      if (nx.length) s += `<path class="opt-l" d="${path(nx, ny)}"/>` + nx.map((x, i) => `<circle class="opt" cx="${sx(x).toFixed(1)}" cy="${sy(ny[i]).toFixed(1)}" r="2.2"/>`).join('');
      const ox = [], oy = []; O.old.t.forEach((t, i) => { if (inr(t)) { ox.push(t); oy.push(O.old.d[i]); } });
      s += `<path class="old-l" d="${path(ox, oy)}"/>` + ox.map((x, i) => `<circle class="old" cx="${sx(x).toFixed(1)}" cy="${sy(oy[i]).toFixed(1)}" r="3"/>`).join('');
      el.innerHTML = s + '</svg>';
      const erupt = onset + O.lead;
      $('ov-read').textContent = `dip onset ${onset.toFixed(2)} -> implied eruption ${erupt.toFixed(2)} (${erupt < NOW ? 'already passed: this alignment is falsified' : (erupt - NOW).toFixed(2) + ' yr from today'})`;
    }
    const setOnset = (v) => {
      onset = +v; $('ov-slider').value = v;
      document.querySelectorAll('[data-on]').forEach((b) => b.setAttribute('aria-pressed', String(Math.abs(+b.dataset.on - onset) < 0.005)));
      overlay();
    };
    $('ov-slider').addEventListener('input', (e) => setOnset(e.target.value));
    document.querySelectorAll('[data-on]').forEach((b) => b.addEventListener('click', () => setOnset(b.dataset.on)));

    // ---------- 7. family bars ----------
    function family() {
      const el = $('fam'); const W = Math.max(300, el.clientWidth); const narrow = W < 560;
      const rows = D.family.slice().sort((a, b) => a.log_ratio - b.log_ratio);
      const lab = narrow ? 128 : 190, R = 14, T = 6, rowH = 26, B = 24, H = T + rows.length * rowH + B;
      const v0 = -0.5, v1 = 4.5;
      const sx = (v) => lab + (v - v0) / (v1 - v0) * (W - lab - R);
      let s = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" xmlns="${NS}">`;
      for (const v of [0, 1, 2, 3, 4]) {
        s += `<line class="gr" x1="${sx(v)}" x2="${sx(v)}" y1="${T}" y2="${H - B}"/>`;
        s += `<text x="${sx(v)}" y="${H - 8}" text-anchor="middle">${(10 ** v).toLocaleString('en-GB')}×</text>`;
      }
      rows.forEach((r, i) => {
        const y = T + i * rowH + rowH / 2, tc = r.name.startsWith('T CrB');
        const name = narrow ? r.name.replace(' quiescence', '').replace('2005-14', '(quiet)').replace(' 2016-22', '') : r.name;
        s += `<text class="lbl" x="${lab - 6}" y="${y + 4}" text-anchor="end">${name}</text>`;
        s += `<rect class="${r.name.includes('Sep') ? 'al' : (tc ? 'uv' : 'xr')}" x="${sx(Math.min(0, r.log_ratio))}" y="${y - 7}" width="${Math.abs(sx(r.log_ratio) - sx(0))}" height="14" opacity="0.85"/>`;
        s += `<line class="fg-l" x1="${sx(r.log_ratio - r.sys_dex)}" x2="${sx(r.log_ratio + r.sys_dex)}" y1="${y}" y2="${y}"/>`;
      });
      s += `<line class="fg-l" x1="${sx(0)}" x2="${sx(0)}" y1="${T}" y2="${H - B}"/>`;
      el.innerHTML = s + '</svg>';
    }

    const drawAll = () => { lightcurves(); overlay(); family(); };
    drawAll();
    let lastW = 0;
    new ResizeObserver(() => { const w = $('lc').clientWidth; if (Math.abs(w - lastW) > 4) { lastW = w; drawAll(); } }).observe(document.body);
  </script>
</Base>
